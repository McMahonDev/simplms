# Copy to .env and adjust. Every value has a local-dev default, so .env is optional
# for `pnpm dev`; production (NODE_ENV=production) requires the ones marked REQUIRED.

# Postgres from docker-compose.yml
DATABASE_URL=postgres://simplms:simplms@localhost:5432/simplms

# REQUIRED in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
# Public origin of the app (Better Auth origin checks and callbacks)
BETTER_AUTH_URL=http://localhost:5173

# Set to "false" to hide /sign-up and reject email sign-ups
ALLOW_SIGNUP=true

# Local disk storage root for uploaded SCORM packages
STORAGE_DIR=./storage

# SCORM upload limits
SCORM_MAX_UPLOAD_MB=500
SCORM_MAX_UNCOMPRESSED_MB=2000
SCORM_MAX_FILES=20000

# Scheduled jobs (reminders, cleanup) run inside the app server every minute.
# Set to "false" to run them from an external cron via POST /api/jobs/run instead.
JOBS_SCHEDULER=true
# Bearer token for POST /api/jobs/run. Leave unset to disable the endpoint.
# CRON_SECRET=

# adapter-node only: max request body for `pnpm build && node build`.
# Must be at least SCORM_MAX_UPLOAD_MB. Not used by `pnpm dev`.
BODY_SIZE_LIMIT=600M
